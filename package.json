{
  "name": "humanly-text-to-speech",
  "version": "1.4.0",
  "private": true,
  "description": "Firefox add-on that reads web pages and PDFs aloud with a natural, human-sounding voice running on your own computer. Click any sentence to jump there.",
  "homepage": "https://github.com/utrox/humanly-text-to-speech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utrox/humanly-text-to-speech.git"
  },
  "bugs": {
    "url": "https://github.com/utrox/humanly-text-to-speech/issues"
  },
  "author": "utrox",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/run-all.mjs",
    "test:helper": "node test/run-all.mjs --helper",
    "test:browser": "python test/browser/run.py",
    "lint": "web-ext lint --source-dir dist",
    "package": "node build.mjs && node tools/package.mjs",
    "start": "web-ext run --source-dir dist"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "web-ext": "^10.7.0",
    "wordlist-english": "^1.2.1"
  }
}
